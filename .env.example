# ==============================================================================
# Automated Investment Committee News Briefing System - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="Investment Committee News Briefing"
LOG_LEVEL=INFO

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/briefings.db

# Briefing Business Rules & Constraints
MAX_INDIA_STORIES=5
MAX_INTERNATIONAL_STORIES=5
STORY_LOOKBACK_DAYS=3
MIN_INDEPENDENT_SOURCES=2

# Pipeline Execution & Resource Limits
MAX_GEMINI_CLASSIFICATIONS=15
MAX_CORROBORATION_SEARCHES=20
MIN_VERIFIED_INDIA=5
MIN_VERIFIED_INTL=5
MAX_DISCOVERY_INDIA=40
MAX_DISCOVERY_INTL=40

# SerpAPI Configuration (Optional Corroboration Fallback)
SERPAPI_API_KEY=your_serpapi_key_here
MAX_SERPAPI_SEARCHES_PER_RUN=8

# Network & Extraction Timeouts
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
